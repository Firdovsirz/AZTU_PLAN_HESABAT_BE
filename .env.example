# Copy this file to .env and fill in real values. NEVER commit the real .env.

# --- Core ---
SECRET_KEY=change-me-use-a-long-random-string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- External LMS API ---
LMS_API_FACULTIES=https://api-lms.aztu.edu.az/api/faculties
LMS_API_CAFEDRAS=https://api-lms.aztu.edu.az/api/cafedras

# --- API keys ---
API_KEY=change-me
REPORT_API_KEY=change-me

# --- Email (SMTP) ---
SENDER_EMAIL=
APP_PASSWORD=
SMTP_SERVER=
SMTP_PORT=587

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
