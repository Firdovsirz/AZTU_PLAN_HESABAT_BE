# Copy to .env and fill in real values. NEVER commit the real .env.

# Comma-separated list of browser origins allowed to call the API (exact
# scheme+host[+port], no trailing slash). Because the API uses
# allow_credentials=True, a wildcard "*" is NOT allowed — every front-end
# origin must be listed explicitly.
#
# This MUST include the PUBLIC landing-page origin, otherwise the browser will
# block the unauthenticated "You Said / We Did" fetch and the section will
# silently not render. Defaults to the localhost dev origins below if unset.
#
# Example (production):
#   CORS_ORIGINS=https://plan-report.aztu.edu.az,https://api-plan-report.aztu.edu.az
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
